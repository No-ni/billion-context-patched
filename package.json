{
  "name": "bili-context-patch",
  "version": "0.6.7",
  "description": "billion-context, patched: verified snapshot reuse, fork inheritance, request-body compression, and the model-request accelerator in one plugin.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/No-ni/billion-context-patched.git"
  },
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "build": "node scripts/install.mjs --build",
    "check": "node scripts/check-all.mjs --offline",
    "check:host": "node scripts/check-all.mjs --host",
    "check:release": "node scripts/check-release.mjs",
    "release:prepare": "node scripts/release.mjs",
    "release:package": "node scripts/package-release.mjs"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "billion-context",
    "compression",
    "latency"
  ],
  "meta": {
    "title": "bili-context-patch",
    "description": "billion-context 的补丁构建，内置模型请求加速；上游 billion-context 与加速器不再单独挂载。"
  },
  "dsh": {
    "bundle": {
      "patch": "./dsh.bundle.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "patchBuild": {
    "id": "4098655f8b7cf21ae0f9bbac06b31c740d1aa5824fc1327c7e027293a26c5ab5",
