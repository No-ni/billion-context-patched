{
  "name": "bili-context-patch",
  "version": "0.1.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/No-ni/billion-context-patched.git"
  },
  "type": "module",
  "description": "billion-context patched build, with dsh-plugin-model-request-accelerator mounted inside it",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "meta": {
    "title": "bili-context-patch",
    "description": "billion-context 的补丁构建，内置模型请求加速；上游 billion-context 与加速器不再单独挂载。"
  },
  "dsh": {
    "bundle": {
      "patch": "./dsh.bundle.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  }
}
